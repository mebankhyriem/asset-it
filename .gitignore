# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (npm workspaces: root + each workspace's node_modules)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
frontend/.next/
frontend/out/

# backend build output
backend/dist/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# database
frontend/data/*.db
frontend/data/*.db-shm
frontend/data/*.db-wal

# uploaded signed documents
frontend/data/uploads/
backend/data/uploads/

# typescript
*.tsbuildinfo
frontend/next-env.d.ts
